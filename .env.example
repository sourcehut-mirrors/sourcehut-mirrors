# Copy to .env (git-ignored); `docker compose` reads it automatically.

# Required. Same permissions the mirror has always needed: push to
# sourcehut-mirrors/* plus Administration:write (fine-grained PAT) / repo
# scope (classic) so mirror-one.sh can repoint a repo's default branch.
GH_MIRROR_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Time between ticks; any GNU sleep duration (e.g. 18m, 3m, 1h).
# Each repo refreshes about every MIRROR_INTERVAL * N (N = lines in repos.txt),
# so set MIRROR_INTERVAL = target-refresh / N. Default 18m -> 6h per repo at N=20.
#MIRROR_INTERVAL=18m

# Optional. The container polls this URL for repos.txt each tick, so pushing to
# master updates the server automatically. Defaults (in the Dockerfile) to this
# repo's raw master. Set to empty to pin to the image's baked-in list instead.
#REPOS_URL=https://raw.githubusercontent.com/sourcehut-mirrors/sourcehut-mirrors/master/repos.txt
